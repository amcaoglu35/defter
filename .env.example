# Defter Kasa & Sistem Ortam Değişkenleri Şablonu

# Kasa Erişim Şifresi (Sunucu tarafı)
DEFTER_ACCESS_PASSWORD=<kendi-sifreni-buraya-yaz>

# Tek Kullanıcılı Google / GitHub OAuth Whitelist E-posta Adresleri (Virgülle ayrılmış)
AUTHORIZED_EMAILS=senin-email-adresin@gmail.com

# Yapay Zeka AI Motoru API Anahtarları (Sunucu Tarafı - Güvenlik İçin Client'a Verilmez)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Veritabanı Yapılandırması
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

