# =========================================================
# DEFTER — Kasa & Sistem Ortam Değişkenleri Şablonu
# =========================================================

# 🔴 Kasa Erişim Şifresi (ZORUNLU - Production'da boş bırakılamaz)
# Güvenliğiniz için güçlü ve benzersiz bir şifre belirleyin.
DEFTER_ACCESS_PASSWORD=kendi-guclu-sifreniz-buraya

# 🔐 Zamanlayıcı Güvenliği (Vercel Cron / Harici Zamanlayıcılar için)
# /api/cron/orakul-daily rotasının güvenli tetiklenmesi için gereklidir.
CRON_SECRET=kendi-cron-secret-anahtariniz

# 👤 Tek Kullanıcılı OAuth Whitelist E-posta Adresleri (Virgülle ayrılmış)
# Tanımlanmazsa production ortamında fail-closed davranılarak tüm OAuth girişleri engellenir.
AUTHORIZED_EMAILS=senin-email-adresin@gmail.com

# 🤖 Yapay Zeka (AI) Motoru API Anahtarları (Sunucu Tarafında Güvenle Saklanır)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 🗄️ Supabase Veritabanı Yapılandırması (Canlı Bulut Senkronizasyonu & Kalıcı Şifre Depolama)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key


