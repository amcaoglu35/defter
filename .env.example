# =========================================================
# DEFTER — Yerel Geliştirme Ortam Değişkenleri (.env.example)
# =========================================================

# 🔴 Kasa Erişim Şifresi (Production'da ZORUNLU)
DEFTER_ACCESS_PASSWORD=kendi-guclu-sifreniz-buraya

# 🔐 Zamanlayıcı Güvenliği
CRON_SECRET=kendi-cron-secret-anahtariniz

# 👤 OAuth Whitelist
AUTHORIZED_EMAILS=

# 🤖 Yapay Zeka (AI) Motoru API Anahtarları
GEMINI_API_KEY=
OPENAI_API_KEY=

# 🗄️ Supabase Veritabanı Yapılandırması (Opsiyonel / Canlı Bulut Senkronizasyonu)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 📨 Dış Kanal Bildirimleri & Otomatik Rapor Dağıtımı (Opsiyonel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
REPORT_EMAIL_TO=
